{
  "name": "timemore-ecommerce",
  "version": "1.0.0",
  "type": "module",
  "description": "Timemore E-commerce platform",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:playwright",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:headed": "playwright test --headed",
    "test:newman": "newman run tests/postman/Timemore-Ecommerce-API.postman_collection.json --reporters cli,html --reporter-html-export test-results/newman-report.html",
    "test:all": "./tests/run-all-tests.sh",
    "install:playwright": "playwright install",
    "install:newman": "npm install -g newman"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4.1.14",
    "autoprefixer": "^10.4.21",
    "axios": "^1.7.4",
    "bootstrap": "^5.3.8",
    "laravel-vite-plugin": "^1.0.0",
    "newman": "^6.0.0",
    "postcss": "^8.5.6",
    "sass": "^1.77.0",
    "tailwindcss": "^4.1.14",
    "vite": "^5.0.0"
  },
  "keywords": [
    "ecommerce",
    "laravel",
    "timemore"
  ],
  "author": "Timemore E-commerce Team",
  "license": "MIT"
}
